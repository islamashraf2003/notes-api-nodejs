# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# ---- Server ----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---- Database --------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/mongoose-playground

# ---- Auth ------------------------------------------------------------------
# REQUIRED. The app refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# How long an issued token stays valid (zeit/ms format: 15m, 2h, 7d).
JWT_EXPIRES_IN=1d

# ---- Email (optional) ------------------------------------------------------
# Leave blank to run without email. Sign-up still works; the welcome
# message is skipped.

# Gmail account used to send mail.
EMAIL_USER=

# Gmail App Password (16 characters, NOT your normal account password).
# Create one at: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=

# Optional display sender. Defaults to: "Note App" <EMAIL_USER>
EMAIL_FROM=
