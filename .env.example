# Copy this file to .env and fill in real values.

# Gmail account used to send emails
EMAIL_USER=your.address@gmail.com

# Gmail App Password (16 characters, NOT your normal account password).
# Create one at: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=

# Optional. Defaults to: "Mongoose Playground" <EMAIL_USER>
EMAIL_FROM=

# Optional. Secret used to sign JWTs.
JWT_SECRET=
